# Target Instagram account (public account recommended)
INSTAGRAM_USERNAME=restaurant_account

# Comma-separated keywords for filtering captions
KEYWORDS=오늘의 메뉴,오늘메뉴,금일메뉴

# Polling interval (seconds)
POLL_SECONDS=300

# Number of latest posts checked each cycle
POST_SCAN_LIMIT=6

# Local SQLite file path
STATE_DB_PATH=state.sqlite3

# true: on first run, existing posts are marked as seen and no alert sent
SEED_WITH_LATEST=true

# Kakao developers app REST API key
KAKAO_REST_API_KEY=your_rest_api_key

# User refresh token with talk_message scope
KAKAO_REFRESH_TOKEN=your_refresh_token
